$TTL    604800
@   IN  SOA pas-paas.local. root.pas-paas.local. (
                  1          ; Serial
                  604800     ; Refresh
                  86400      ; Retry
                  2419200    ; Expire
                  604800 )   ; Negative Cache TTL

@   IN  NS  ns.pas-paas.local.
101 IN  PTR ns.pas-paas.local.
